# ============================================================
# FieldVerse — environment configuration
# Copy to .env (repo root). Never commit .env.
# ============================================================

# ---------- Backend (apps/api) — server-side ONLY ----------
NODE_ENV=development
PORT=5000
# Leave empty to run without a database (public demo still works; saving is disabled).
# Local options: `npm run db:memory` (no install needed) or `docker compose up -d mongo`.
MONGODB_URI=mongodb://127.0.0.1:27017/fieldverse

# Analysis provider: "demo" (illustrative fixtures, no Python needed) or "remote" (AI/ML FastAPI service)
ANALYSIS_PROVIDER=demo
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=15000
# Optional bearer token for the ML service (server-side only, never exposed to the browser)
ML_SERVICE_API_KEY=
# If the remote service fails, let the UI OFFER a clearly labelled demo result (never automatic)
ALLOW_DEMO_FALLBACK_OFFER=true

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# auto = secure cookies only in production
COOKIE_SECURE=auto
# Optional override for the fixtures directory (defaults to <repo>/data/demo)
DEMO_DATA_DIR=
ENGINE_CACHE_TTL_SECONDS=21600
GUEST_DATA_TTL_DAYS=30
LOG_LEVEL=info

# ---------- Frontend (apps/web) — PUBLIC, bundled into the browser ----------
# Only non-secret values may use the VITE_ prefix.
# Default "/api/v1" uses the Vite dev proxy (no CORS needed). For a separately hosted API use the full URL.
VITE_API_BASE_URL=/api/v1

# ---------- Community (backend only) ----------
# New and edited posts wait for a moderator before they are public (recommended: true)
COMMUNITY_PREMODERATION=true
# A published post is hidden for review after this many distinct reports
COMMUNITY_AUTO_HIDE_REPORTS=3
# Secret used to sign resolved community areas. Set a long random value in production;
# if empty, a random one is generated at start-up and every restart invalidates locations already chosen in open pages.
COMMUNITY_AREA_SECRET=

# Roots of Tomorrow /recommend page: "live" = real engine through the API (needs the ml-service), "mock" = sample engine outputs
VITE_RECOMMEND_MODE=mock
