{
  "$ref": "#/definitions/gap-analysis.request",
  "definitions": {
    "gap-analysis.request": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "regionId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "field": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "currentCrop": {
              "type": "string",
              "minLength": 2,
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "cropHistory": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "maxItems": 12,
              "default": []
            },
            "harvestMonth": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 12
                    },
                    {
                      "type": "string",
                      "const": "harvested"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "nextPlantingMonth": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                {
                  "type": "null"
                }
              ]
            },
            "seasonsPerYear": {
              "anyOf": [
                {
                  "type": "number",
                  "enum": [
                    1,
                    2,
                    3
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "soilType": {
              "type": "string",
              "enum": [
                "clay",
                "loam",
                "sandy",
                "silt",
                "unknown"
              ],
              "default": "unknown"
            },
            "soilPh": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 3,
                  "maximum": 10
                },
                {
                  "type": "null"
                }
              ]
            },
            "irrigation": {
              "type": "string",
              "enum": [
                "none",
                "limited",
                "full",
                "unknown"
              ],
              "default": "unknown"
            },
            "waterlogging": {
              "type": "string",
              "enum": [
                "several_weeks",
                "few_days",
                "drains_well",
                "unknown"
              ],
              "default": "unknown"
            },
            "inputLevel": {
              "type": "string",
              "enum": [
                "minimal",
                "moderate",
                "high",
                "unknown"
              ],
              "default": "unknown"
            },
            "excludedCrops": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "maxItems": 30,
              "default": []
            },
            "areaHectares": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 100000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "latitude",
            "longitude",
            "currentCrop"
          ],
          "additionalProperties": false
        },
        "idleMonths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "maxItems": 12,
          "default": []
        },
        "locale": {
          "type": "string",
          "maxLength": 10,
          "default": "en"
        }
      },
      "required": [
        "schemaVersion",
        "regionId",
        "field"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
